{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InfraGuardMetadataRead",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeSecurityGroupRules",
        "ec2:DescribeVpcs",
        "s3:ListAllMyBuckets",
        "s3:GetBucketAcl",
        "s3:GetBucketPublicAccessBlock",
        "s3:GetEncryptionConfiguration",
        "s3:GetBucketVersioning",
        "iam:ListPolicies",
        "iam:GetPolicy",
        "iam:GetPolicyVersion"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ExplicitDenyDataAndWrites",
      "Effect": "Deny",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "ec2:Create*", "ec2:Delete*", "iam:Create*", "iam:Delete*", "iam:PassRole"],
      "Resource": "*"
    }
  ]
}

